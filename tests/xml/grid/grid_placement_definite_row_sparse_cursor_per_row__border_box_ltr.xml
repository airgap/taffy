<test name="grid_placement_definite_row_sparse_cursor_per_row__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" grid-template-rows="20px 20px" grid-template-columns="40px 40px 40px 40px">
      <div direction="ltr" grid-row-start="1" grid-column-start="span 2"/>
      <div direction="ltr" grid-row-start="1" grid-row-end="span 2" grid-column-start="span 2"/>
      <div direction="ltr" grid-row-start="2" grid-column-start="span 2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="160" height="40">
      <node x="0" y="0" width="80" height="20"/>
      <node x="80" y="0" width="80" height="40"/>
      <node x="0" y="20" width="80" height="20"/>
    </node>
  </expectations>
</test>
