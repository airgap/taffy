<test name="grid_auto_rows_spanning_item_auto_height_container__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" width="200px" grid-template-rows="auto auto minmax(auto,0fr)" grid-template-columns="100px 100px">
      <div direction="rtl" height="20px"/>
      <div direction="rtl" height="100px" grid-row-start="span 2"/>
      <div direction="rtl" min-height="0px" grid-row-start="2" grid-column-start="1">
        <div direction="rtl" height="60px"/>
      </div>
      <div direction="rtl" min-height="0px" grid-row-start="3" grid-column-start="span 2">
        <div direction="rtl" height="60px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="100" y="0" width="100" height="20"/>
      <node x="0" y="0" width="100" height="100"/>
      <node x="100" y="30" width="100" height="70">
        <node x="100" y="0" width="0" height="60"/>
      </node>
      <node x="0" y="100" width="200" height="0">
        <node x="200" y="0" width="0" height="60"/>
      </node>
    </node>
  </expectations>
</test>
