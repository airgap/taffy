<test name="grid_fr_item_preferred_size_clamped_by_max_size__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" width="400px" grid-template-columns="100px 1fr">
      <div box-sizing="content-box" direction="ltr" height="20px"/>
      <div box-sizing="content-box" direction="ltr" width="500px" height="20px" max-width="250px" margin-top="0px" margin-left="auto" margin-bottom="0px" margin-right="auto"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="20">
      <node x="0" y="0" width="100" height="20"/>
      <node x="125" y="0" width="250" height="20"/>
    </node>
  </expectations>
</test>
