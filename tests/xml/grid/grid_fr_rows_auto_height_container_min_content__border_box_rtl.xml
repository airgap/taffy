<test name="grid_fr_rows_auto_height_container_min_content__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="rtl" flex-direction="column" width="200px" height="10px">
      <div display="grid" direction="rtl" grid-template-rows="0fr">
        <div direction="rtl" min-height="0px">
          <div direction="rtl" height="60px"/>
        </div>
      </div>
      <div display="grid" direction="rtl" grid-template-rows="1fr">
        <div direction="rtl" min-height="0px">
          <div direction="rtl" height="60px"/>
        </div>
      </div>
      <div display="grid" direction="rtl" grid-template-rows="0fr">
        <div direction="rtl">
          <div direction="rtl" height="60px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="10">
      <node x="0" y="0" width="200" height="0">
        <node x="0" y="0" width="200" height="0">
          <node x="200" y="0" width="0" height="60"/>
        </node>
      </node>
      <node x="0" y="0" width="200" height="60">
        <node x="0" y="0" width="200" height="60">
          <node x="200" y="0" width="0" height="60"/>
        </node>
      </node>
      <node x="0" y="60" width="200" height="60">
        <node x="0" y="0" width="200" height="60">
          <node x="200" y="0" width="0" height="60"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
