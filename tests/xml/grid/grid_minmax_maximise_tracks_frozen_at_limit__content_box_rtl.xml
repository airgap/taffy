<test name="grid_minmax_maximise_tracks_frozen_at_limit__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" width="240px" grid-template-rows="40px" grid-template-columns="minmax(0px,200px) minmax(0px,80px)">
      <div box-sizing="content-box" direction="rtl"/>
      <div box-sizing="content-box" direction="rtl"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="240" height="40">
      <node x="80" y="0" width="160" height="40"/>
      <node x="0" y="0" width="80" height="40"/>
    </node>
  </expectations>
</test>
